# Copy to .env and fill in. Never commit .env.

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# Pari
PARI_LANGUAGE=gu            # gu | hi | en
PARI_API_TOKEN=             # long random string; required to call the web API

# Broker: paper (default, simulated) | alpaca
BROKER=paper
ALPACA_API_KEY=
ALPACA_API_SECRET=
LIVE_TRADING=false          # true + a real broker = real money. Test on paper first.
AUTO_EXECUTE=false          # false = every order waits for your "yes"

# Risk limits
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=10.0
MAX_DAILY_LOSS_PCT=3.0
MIN_REWARD_RISK=1.5

# News + voice
ALPHA_VANTAGE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
