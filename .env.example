# Copy to .env and fill in. .env is gitignored - never commit it, never paste it in chat.

# --- Core ---------------------------------------------------------------
# Encrypts sensitive fields (TOTP secrets, later memories). Generate once and back it up
# somewhere safe (password manager). Losing it means re-enrolling the authenticator.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PARI_DATA_KEY=

# development | production
PARI_ENV=development
# Local dev uses SQLite automatically. Production (docker compose) builds the Postgres URL itself.
# DATABASE_URL=sqlite:///./pari-dev.db

# --- Production / docker compose ----------------------------------------
# Your domain pointing at the server, e.g. pari.example.com
PARI_DOMAIN=localhost
# Long random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# --- Later phases (not used yet) ----------------------------------------
# ANTHROPIC_API_KEY=        Phase 3
# ELEVENLABS_API_KEY=       Phase 3
# GOOGLE_APPLICATION_CREDENTIALS=  Phase 3 (path to a service-account file, not the file contents)
# OANDA_API_TOKEN=          Phase 5 (demo account)
